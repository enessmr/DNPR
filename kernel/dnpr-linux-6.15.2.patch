--- a/drivers/gpu/drm/drm_panic.c
+++ b/drivers/gpu/drm/drm_panic.c
@@ -32,6 +32,9 @@
 
 #include "drm_crtc_internal.h"
 #include "drm_draw_internal.h"
+#ifdef CONFIG_DRM_DNPR
+#include "dnpr_panic.h"
+#endif
 
 MODULE_AUTHOR("Jocelyn Falempe");
 MODULE_DESCRIPTION("DRM panic handler");
@@ -667,6 +670,10 @@
 
 static void draw_panic_dispatch(struct drm_scanout_buffer *sb)
 {
+#ifdef CONFIG_DRM_DNPR
+	if (!strcmp(drm_panic_screen, "dnpr") && dnpr_panic_render(sb))
+		return;
+#endif
 	if (!strcmp(drm_panic_screen, "kmsg")) {
 		draw_panic_static_kmsg(sb);
 	} else if (!strcmp(drm_panic_screen, "qr_code")) {
@@ -737,9 +744,30 @@ static struct drm_plane *to_drm_plane(struct kmsg_dumper *kd)
 static void drm_panic(struct kmsg_dumper *dumper, struct kmsg_dump_detail *detail)
 {
 	struct drm_plane *plane = to_drm_plane(dumper);
+#ifdef CONFIG_DRM_DNPR
+	static bool dnpr_started;
+	struct drm_plane *other;
+#endif
 
-	if (detail->reason == KMSG_DUMP_PANIC)
-		draw_panic_plane(plane, detail->description);
+	if (detail->reason != KMSG_DUMP_PANIC)
+		return;
+#ifdef CONFIG_DRM_DNPR
+	if (!strcmp(drm_panic_screen, "dnpr")) {
+		if (dnpr_started)
+			return;
+		dnpr_started = true;
+		/* All plane dumpers for this device share one clock. Collect each
+		 * scanout before the animation loop, including the second monitor.
+		 */
+		drm_for_each_plane(other, plane->dev)
+			if (other->helper_private &&
+			    other->helper_private->get_scanout_buffer)
+				draw_panic_plane(other, detail->description);
+		dnpr_panic_animate();
+		return;
+	}
+#endif
+	draw_panic_plane(plane, detail->description);
 }
 
 /**
@@ -847,5 +875,9 @@
 void __init drm_panic_init(void)
 {
 	drm_panic_qr_init();
+#ifdef CONFIG_DRM_DNPR
+	if (dnpr_panic_init())
+		pr_warn("DNPR: scene preload failed; using standard panic screen\n");
+#endif
 }
 
@@ -854,5 +886,8 @@
  */
 void drm_panic_exit(void)
 {
+#ifdef CONFIG_DRM_DNPR
+	dnpr_panic_exit();
+#endif
 	drm_panic_qr_exit();
 }
