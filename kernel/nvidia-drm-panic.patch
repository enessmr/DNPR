+static int nv_drm_primary_plane_get_scanout_buffer(struct drm_plane *plane,
+                                                   struct drm_scanout_buffer *sb)
+{
+    struct drm_framebuffer *fb;
+    struct nv_drm_framebuffer *nv_fb;
+    struct drm_gem_object *gem;
+    struct nv_drm_gem_object *nv_gem;
+    struct nv_drm_gem_nvkms_memory *nv_nvkms_memory;
+
+    if (!plane->state || !plane->state->fb)
+        return -EINVAL;
+
+    fb = plane->state->fb;
+    if (fb->format->num_planes != 1)
+        return -EOPNOTSUPP;
+
+    nv_fb = to_nv_framebuffer(fb);
+    if (!nv_fb)
+        return -EINVAL;
+
+    gem = nv_fb_get_gem_obj(fb, 0);
+    if (!gem)
+        return -EINVAL;
+
+    nv_gem = to_nv_gem_object(gem);
+    if (!nv_gem || nv_gem->ops != &nv_gem_nvkms_memory_ops)
+        return -EOPNOTSUPP;
+
+    nv_nvkms_memory = to_nv_nvkms_memory(nv_gem);
+    if (!nv_nvkms_memory || !nv_nvkms_memory->physically_mapped ||
+        !nv_nvkms_memory->pWriteCombinedIORemapAddress)
+        return -ENOMEM;
+
+    iosys_map_set_vaddr_iomem(&sb->map[0],
+        (void __iomem *)((char *)nv_nvkms_memory->pWriteCombinedIORemapAddress + fb->offsets[0]));
+
+    sb->width = fb->width;
+    sb->height = fb->height;
+    sb->pitch[0] = fb->pitches[0];
+    sb->format = fb->format;
+
+    if (nv_fb->is_block_linear) {
+        unsigned int gobs = 1 << nv_fb->log2_gobs_per_block_y;
+        if (!gobs)
+            gobs = 16;
+        nv_panic_blk_h = NV_TILE_GOB_HEIGHT * gobs;
+        if (fb->format->cpp[0] != 4)
+            return -EOPNOTSUPP;
+        sb->set_pixel = nv_drm_panic_set_pixel;
+        sb->set_pixels = nv_drm_panic_set_pixels;
+    } else {
+        sb->set_pixel = NULL;
+        sb->set_pixels = NULL;
+    }
+
+    return 0;
+}
