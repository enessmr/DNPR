+static u32 nv_panic_blk_h = 128;
+
+static void nv_drm_panic_set_pixel(struct drm_scanout_buffer *sb,
+                                   unsigned int x, unsigned int y,
+                                   u32 color)
+{
+    u32 blk_columns, blk_x, blk_y, blk_off, in_blk_x, in_blk_y, off;
+
+    blk_columns = DIV_ROUND_UP(sb->pitch[0], NV_TILE_GOB_WIDTH_BYTES);
+    blk_x = (x * 4) / NV_TILE_GOB_WIDTH_BYTES;
+    blk_y = y / nv_panic_blk_h;
+    blk_off = ((blk_y * blk_columns) + blk_x) * (NV_TILE_GOB_WIDTH_BYTES * nv_panic_blk_h);
+
+    in_blk_x = x % (NV_TILE_GOB_WIDTH_BYTES / 4);
+    in_blk_y = y % nv_panic_blk_h;
+    off = blk_off + in_blk_x * 4 + in_blk_y * NV_TILE_GOB_WIDTH_BYTES;
+
+    iosys_map_wr(&sb->map[0], off, u32, color);
+}
+
+static void nv_drm_panic_set_pixels(struct drm_scanout_buffer *sb,
+                                    unsigned int x, unsigned int y,
+                                    const u32 *colors, unsigned int count)
+{
+    u32 blk_columns = DIV_ROUND_UP(sb->pitch[0], NV_TILE_GOB_WIDTH_BYTES);
+
+    while (count) {
+        u32 blk_x = (x * 4) / NV_TILE_GOB_WIDTH_BYTES;
+        u32 blk_y = y / nv_panic_blk_h;
+        u32 blk_off = ((blk_y * blk_columns) + blk_x) *
+                      (NV_TILE_GOB_WIDTH_BYTES * nv_panic_blk_h);
+        u32 in_blk_x = x % (NV_TILE_GOB_WIDTH_BYTES / 4);
+        u32 in_blk_y = y % nv_panic_blk_h;
+        u32 off = blk_off + in_blk_x * 4 + in_blk_y * NV_TILE_GOB_WIDTH_BYTES;
+        u32 span = min_t(u32, count,
+                         NV_TILE_GOB_WIDTH_BYTES / 4 - in_blk_x);
+
+        iosys_map_memcpy_to(&sb->map[0], off, colors, span * sizeof(*colors));
+        x += span;
+        colors += span;
+        count -= span;
+    }
+}
